{
  "name": "island-for-windows",
  "productName": "Island",
  "version": "0.1.3",
  "description": "An animated activity pill for the top of your Windows screen",
  "author": "Yusuf",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "framer-motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "com.yusuf.island",
    "productName": "Island",
    "copyright": "Copyright © 2026 Yusuf",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "windows-helper.ps1",
          "tray*.png",
          "island.ico"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/island.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Island",
      "uninstallDisplayName": "Island",
      "runAfterFinish": true,
      "installerIcon": "resources/island.ico",
      "uninstallerIcon": "resources/island.ico"
    }
  }
}
